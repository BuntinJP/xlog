{
  "name": "xlog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "types:prepare": "bun scripts/prepare-typegen.ts",
    "types:generate": "bun run types:prepare && next typegen",
    "types:check": "bun run types:generate && tsc --noEmit",
    "types:check:compat": "bun run types:generate && tsc6 --noEmit",
    "lint": "bun run types:generate && oxlint --deny-warnings .",
    "lint:fix": "bun run types:generate && oxlint --fix .",
    "verify:migration": "bun scripts/verify-migration.ts",
    "frontmatter:warn": "bun scripts/warn-stale-frontmatter.ts",
    "images:convert": "bun scripts/convert-images.ts",
    "check": "bun run verify:migration && bun run lint && bun run types:check && bun run types:check:compat && bun run build",
    "ci": "bun install --frozen-lockfile && bun run check"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "cnfast": "0.1.0",
    "fumadocs-core": "16.14.0",
    "fumadocs-mdx": "15.2.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.14.0",
    "lucide-react": "1.28.0",
    "negotiator": "1.0.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/negotiator": "0.6.4",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript6-runtime": "npm:typescript@6.0.3"
  },
  "patchedDependencies": {
    "fumadocs-core@16.14.0": "patches/fumadocs-core@16.14.0.patch",
    "fumadocs-mdx@15.2.2": "patches/fumadocs-mdx@15.2.2.patch",
    "@typescript/typescript6@6.0.2": "patches/@typescript%2Ftypescript6@6.0.2.patch"
  }
}
